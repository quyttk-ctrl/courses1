<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hệ Thống Chấm Điểm</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Segoe UI,Arial,sans-serif;
}
body{
background:linear-gradient(135deg,#667eea,#764ba2);
padding:25px;
min-height:100vh;
}
.container{
max-width:1700px;
margin:auto;
}
.header{
background:white;
padding:30px;
border-radius:20px;
margin-bottom:20px;
box-shadow:0 4px 20px rgba(0,0,0,.1);
}
.grid{
display:grid;
grid-template-columns:360px 1fr;
gap:20px;
}
.card{
background:white;
padding:25px;
border-radius:20px;
box-shadow:0 4px 20px rgba(0,0,0,.08);
}
.input-box{
margin-bottom:20px;
}
.input-box label{
display:block;
font-weight:600;
margin-bottom:8px;
}
.input-box input{
width:100%;
padding:12px;
border:1px solid #ddd;
border-radius:10px;
}
.dropzone{
border:3px dashed #667eea;
border-radius:18px;
padding:40px 20px;
text-align:center;
cursor:pointer;
background:#fafbff;
transition:.3s;
min-height:220px;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
}
.dropzone:hover{
background:#f2f5ff;
}
.drag{
background:#eef2ff;
}
.upload-icon{
font-size:55px;
margin-bottom:15px;
}
#fileLabel{
font-size:24px;
font-weight:bold;
margin-bottom:10px;
word-break:break-word;
}
button{
width:100%;
padding:14px;
margin-top:12px;
border:none;
border-radius:12px;
cursor:pointer;
font-size:16px;
font-weight:bold;
}
.primary{
background:#667eea;
color:white;
}
.success{
background:#2ecc71;
color:white;
}
.table-wrap{
overflow:auto;
max-height:700px;
}
table{
width:100%;
border-collapse:collapse;
}
th{
background:#667eea;
color:white;
padding:12px;
position:sticky;
top:0;
}
td{
padding:10px;
border-bottom:1px solid #eee;
text-align:center;
}
.badge{
padding:5px 12px;
border-radius:20px;
font-size:12px;
}
.ok{
background:#d4edda;
color:#1d6b2a;
}
.error{
background:#ffd6d6;
color:#b00020;
}
@media(max-width:1000px){
.grid{
grid-template-columns:1fr;
}
}
</style>
</head>

<body>

<div class="container">

<div class="header">
<h1>📊 Hệ Thống Chấm Điểm</h1>
<p>Upload file Excel chứa đáp án + bài sinh viên</p>
</div>

<div class="grid">

<div class="card">
<div class="input-box">
<label>Số câu Listening</label>
<input id="listeningCount" type="number" value="15" min="1">
</div>

<div class="input-box">
<label>Số câu Reading</label>
<input id="readingCount" type="number" value="40" min="1">
</div>

<div class="dropzone" id="dropzone">
<div class="upload-icon">📂</div>
<div id="fileLabel">Chọn file Excel hoặc kéo thả</div>
<input id="excelInput" type="file" accept=".xlsx,.xls" style="display:none" onchange="loadExcel(this)">
</div>

<button class="primary" onclick="scoreAll()">🧮 Chấm điểm</button>
<button class="success" onclick="exportExcel()">📥 Xuất Excel</button>

<div id="message" style="margin-top:15px; font-weight:500;"></div>
</div>

<div class="card">
<div class="table-wrap">
<table>
<thead>
<tr>
<th>SBD</th>
<th>Mã đề</th>
<th>Listening (/10)</th>
<th>Đúng Listening</th>
<th>% Listening</th>
<th>Reading (/10)</th>
<th>Đúng Reading</th>
<th>% Reading</th>
<th>Status</th>
</tr>
</thead>
<tbody id="tbody"></tbody>
</table>
</div>
</div>

</div>
</div>

<script>
let rawRows = [];
let students = [];
let answerKeys = {};
let questionCols = [];
let results = [];

const dropzone = document.getElementById("dropzone");
const input = document.getElementById("excelInput");

dropzone.onclick = () => input.click();

dropzone.addEventListener("dragover", e => {
    e.preventDefault();
    dropzone.classList.add("drag");
});

dropzone.addEventListener("dragleave", () => {
    dropzone.classList.remove("drag");
});

dropzone.addEventListener("drop", e => {
    e.preventDefault();
    dropzone.classList.remove("drag");
    if (e.dataTransfer.files.length) {
        input.files = e.dataTransfer.files;
        loadExcel(input);
    }
});

function msg(text) {
    document.getElementById("message").innerHTML = text;
}

function loadExcel(inputEl) {
    const file = inputEl.files[0];
    if (!file) return;

    document.getElementById("fileLabel").innerHTML = "📄 " + file.name;

    const reader = new FileReader();
    reader.onload = e => {
        const wb = XLSX.read(new Uint8Array(e.target.result), { type: "array" });
        const sheet = wb.Sheets[wb.SheetNames[0]];
        rawRows = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: "", raw: false });
        prepare();
    };
    reader.readAsArrayBuffer(file);
}

function prepare() {
    students = [];
    answerKeys = {};
    questionCols = [];

    let headerRow = -1;
    for (let i = 0; i < rawRows.length; i++) {
        if (rawRows[i].some(x => String(x).trim().toUpperCase() === "SBD")) {
            headerRow = i;
            break;
        }
    }

    if (headerRow === -1) {
        msg("❌ Không tìm thấy cột SBD");
        return;
    }

    const header = rawRows[headerRow];
    const sbdIndex = header.findIndex(x => String(x).toUpperCase() === "SBD");
    const codeIndex = header.findIndex(x => String(x).includes("Mã"));

    header.forEach((col, index) => {
        const num = parseInt(col);
        if (!isNaN(num)) {
            questionCols.push({ question: num, col: index });
        }
    });

    questionCols.sort((a, b) => a.question - b.question);

    // Đáp án
    for (let i = 1; i < headerRow; i++) {
        const row = rawRows[i];
        const code = String(row[codeIndex] || '').trim();
        if (!code) continue;

        answerKeys[code] = questionCols.map(q => 
            String(row[q.col] || '').trim().toUpperCase()
        );
    }

    // Sinh viên
    for (let i = headerRow + 1; i < rawRows.length; i++) {
        const row = rawRows[i];
        const sbd = String(row[sbdIndex] || '').trim();
        if (!sbd) continue;

        students.push({
            sbd,
            code: String(row[codeIndex] || '').trim(),
            row
        });
    }

    msg(`✅ Đọc được <b>${students.length}</b> sinh viên và <b>${Object.keys(answerKeys).length}</b> mã đề`);
}

function scoreAll() {
    const listeningQ = parseInt(document.getElementById("listeningCount").value) || 0;
    const readingQ = parseInt(document.getElementById("readingCount").value) || 0;

    if (listeningQ <= 0 || readingQ <= 0) {
        msg("❌ Vui lòng nhập số câu Listening và Reading lớn hơn 0");
        return;
    }

    results = [];

    students.forEach(st => {
        const key = answerKeys[st.code];
        if (!key) {
            results.push({
                sbd: st.sbd,
                code: st.code,
                status: "Lỗi mã đề"
            });
            return;
        }

        let listeningCorrect = 0;
        let readingCorrect = 0;

        questionCols.forEach((q, index) => {
            const studentAns = String(st.row[q.col] || '').trim().toUpperCase();
            const correctAns = String(key[index] || '').trim().toUpperCase();

            if (studentAns && studentAns === correctAns) {
                if (index < listeningQ) {
                    listeningCorrect++;
                } else {
                    readingCorrect++;
                }
            }
        });

        // Tính điểm theo công thức mới: mỗi phần tối đa 10 điểm
        const listeningScore = (listeningCorrect * 10 / listeningQ).toFixed(2);
        const readingScore = (readingCorrect * 10 / readingQ).toFixed(2);

        results.push({
            sbd: st.sbd,
            code: st.code,
            listening: listeningScore,
            listeningCorrect,
            listeningPercent: ((listeningCorrect / listeningQ) * 100).toFixed(1) + "%",
            reading: readingScore,
            readingCorrect,
            readingPercent: ((readingCorrect / readingQ) * 100).toFixed(1) + "%",
            status: "OK"
        });
    });

    render();
}

function render() {
    const tbody = document.getElementById("tbody");
    tbody.innerHTML = '';

    results.forEach(r => {
        tbody.innerHTML += `
        <tr>
            <td>${r.sbd}</td>
            <td>${r.code}</td>
            <td><b>${r.listening || '-'}</b></td>
            <td>${r.listeningCorrect || '-'}</td>
            <td>${r.listeningPercent || '-'}</td>
            <td><b>${r.reading || '-'}</b></td>
            <td>${r.readingCorrect || '-'}</td>
            <td>${r.readingPercent || '-'}</td>
            <td>
                <span class="badge ${r.status === "OK" ? "ok" : "error"}">
                    ${r.status}
                </span>
            </td>
        </tr>`;
    });
}

function exportExcel() {
    if (results.length === 0) {
        msg("❌ Chưa có dữ liệu để xuất. Vui lòng chấm điểm trước.");
        return;
    }

    const data = [[
        "SBD", "Mã đề",
        "Listening (/10)", "Đúng Listening", "% Listening",
        "Reading (/10)", "Đúng Reading", "% Reading",
        "Status"
    ]];

    results.forEach(r => {
        data.push([
            r.sbd, r.code,
            r.listening, r.listeningCorrect, r.listeningPercent,
            r.reading, r.readingCorrect, r.readingPercent,
            r.status
        ]);
    });

    const ws = XLSX.utils.aoa_to_sheet(data);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "KetQua");

    const now = new Date().toISOString().slice(0,10).replace(/-/g, '');
    XLSX.writeFile(wb, `KetQua_${now}.xlsx`);
}
</script>

</body>
</html>
