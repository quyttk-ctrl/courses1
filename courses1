function scoreAll(){

const listeningQuestions =
parseInt(
document.getElementById("listeningCount").value
) || 0;

const readingQuestions =
parseInt(
document.getElementById("readingCount").value
) || 0;

if(
listeningQuestions <= 0 ||
readingQuestions <= 0
){
msg("❌ Vui lòng nhập số câu Listening và Reading");
return;
}

results=[];

students.forEach(st=>{

const key = answerKeys[st.code];

if(!key){

results.push({
sbd:st.sbd,
code:st.code,
status:"Lỗi mã đề"
});

return;
}

let listeningCorrect = 0;
let readingCorrect = 0;

questionCols.forEach((q,index)=>{

const studentAns =
String(st.row[q.col]||'')
.trim()
.toUpperCase();

const correctAns =
String(key[index]||'')
.trim()
.toUpperCase();

if(studentAns === correctAns){

if(index < listeningQuestions){

listeningCorrect++;

}else{

readingCorrect++;

}

}

});

const listeningScore =
(
listeningCorrect *
(10/listeningQuestions)
).toFixed(2);

const readingScore =
(
readingCorrect *
(10/readingQuestions)
).toFixed(2);

results.push({

sbd:st.sbd,
code:st.code,

listening:listeningScore,
listeningCorrect,

listeningPercent:
(
listeningCorrect /
listeningQuestions *
100
).toFixed(1) + "%",

reading:readingScore,
readingCorrect,

readingPercent:
(
readingCorrect /
readingQuestions *
100
).toFixed(1) + "%",

status:"OK"

});

});

render();

msg(
`✅ Đã chấm ${results.length} sinh viên`
);

}
